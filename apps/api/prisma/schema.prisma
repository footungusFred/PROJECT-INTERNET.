generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique @db.VarChar(24)
  email     String   @unique @db.VarChar(254)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sites     Site[]
}

model Site {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String       @db.VarChar(80)
  description String       @default("") @db.VarChar(240)
  status      SiteStatus   @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  domains     Domain[]
  pages       Page[]

  @@index([ownerId, updatedAt])
  @@index([status])
}

model Domain {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  hostname  String   @unique @db.VarChar(63)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([siteId])
}

model Page {
  id          String       @id @default(cuid())
  siteId      String
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug        String       @db.VarChar(80)
  title       String       @db.VarChar(120)
  description String       @default("") @db.VarChar(240)
  content     Json
  status      PageStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  outgoing    InternalLink[] @relation("LinkSource")
  incoming    InternalLink[] @relation("LinkTarget")

  @@unique([siteId, slug])
  @@index([status, publishedAt])
}

model InternalLink {
  id            String   @id @default(cuid())
  sourcePageId  String
  targetPageId  String
  sourcePage    Page     @relation("LinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage    Page     @relation("LinkTarget", fields: [targetPageId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([sourcePageId, targetPageId])
  @@index([targetPageId])
}

enum SiteStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
